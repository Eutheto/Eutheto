{
  "$defs": {
    "cache_value": {
      "oneOf": [
        {
          "type": "boolean"
        },
        {
          "maximum": 9223372036854775807,
          "minimum": -9223372036854775808,
          "type": "integer"
        },
        {
          "description": "A scalar measured cache value. Path values use @artifact-root@, @build-root@, @source-root@, @target-root@, or @toolchain-root@; literal macOS loader values may use @loader_path or @rpath. Raw host paths and unknown @ tokens are forbidden.",
          "maxLength": 2048,
          "anyOf": [
            {
              "pattern": "^[^/\\\\\\u0000-\\u001f\\u007f]*$"
            },
            {
              "pattern": "^@(?:(?:artifact-root|build-root|source-root|target-root|toolchain-root)@|loader_path|rpath)(?:/(?!\\.{1,2}(?:/|$))[^/\\\\:@;=$%~\\s]+)*$"
            },
            {
              "const": "/DEIGEN_MPL2_ONLY"
            }
          ],
          "type": "string"
        }
      ]
    },
    "cmake_map": {
      "additionalProperties": false,
      "maxProperties": 128,
      "minProperties": 26,
      "patternProperties": {
        "^[A-Za-z_][A-Za-z0-9_]{0,127}$": {
          "$ref": "#/$defs/cache_value"
        }
      },
      "propertyNames": {
        "enum": [
          "BUILD_CXX",
          "BUILD_CXX_EXAMPLES",
          "BUILD_CXX_SAMPLES",
          "BUILD_DEPS",
          "BUILD_DOC",
          "BUILD_DOTNET",
          "BUILD_EXAMPLES",
          "BUILD_FLATZINC",
          "BUILD_JAVA",
          "BUILD_MATH_OPT",
          "BUILD_PYTHON",
          "BUILD_SAMPLES",
          "BUILD_SHARED_LIBS",
          "BUILD_TESTING",
          "CMAKE_BUILD_TYPE",
          "CMAKE_CXX_COMPILER",
          "CMAKE_CXX_FLAGS",
          "CMAKE_C_COMPILER",
          "CMAKE_FIND_USE_CMAKE_ENVIRONMENT_PATH",
          "CMAKE_FIND_USE_PACKAGE_REGISTRY",
          "CMAKE_FIND_USE_PACKAGE_ROOT_PATH",
          "CMAKE_FIND_USE_SYSTEM_PACKAGE_REGISTRY",
          "CMAKE_GENERATOR",
          "CMAKE_INSTALL_NAME_DIR",
          "CMAKE_INSTALL_PREFIX",
          "CMAKE_INSTALL_RPATH",
          "CMAKE_MACOSX_RPATH",
          "CMAKE_MSVC_RUNTIME_LIBRARY",
          "CMAKE_POLICY_DEFAULT_CMP0077",
          "CMAKE_PREFIX_PATH",
          "EUTHETO_ORTOOLS_BUILD_CANDIDATE_BENCHMARKS",
          "EUTHETO_ORTOOLS_BUILD_TESTS",
          "EUTHETO_ORTOOLS_DEVELOPMENT_BUILD",
          "EUTHETO_ORTOOLS_PHASE3_CONTRACT",
          "FETCHCONTENT_FULLY_DISCONNECTED",
          "FETCHCONTENT_SOURCE_DIR_ABSL",
          "FETCHCONTENT_SOURCE_DIR_BZIP2",
          "FETCHCONTENT_SOURCE_DIR_EIGEN3",
          "FETCHCONTENT_SOURCE_DIR_PROTOBUF",
          "FETCHCONTENT_SOURCE_DIR_RE2",
          "FETCHCONTENT_SOURCE_DIR_ZLIB",
          "INSTALL_BUILD_DEPS",
          "Protobuf_DIR",
          "USE_BOP",
          "USE_COINOR",
          "USE_CPLEX",
          "USE_GLOP",
          "USE_GLPK",
          "USE_GUROBI",
          "USE_HIGHS",
          "USE_PDLP",
          "USE_SCIP",
          "USE_XPRESS",
          "ortools_DIR"
        ]
      },
      "type": "object"
    },
    "non_windows_cmake_map": {
      "not": {
        "required": ["CMAKE_MSVC_RUNTIME_LIBRARY"]
      },
      "type": "object"
    },
    "windows_cmake_map": {
      "properties": {
        "CMAKE_MSVC_RUNTIME_LIBRARY": {
          "const": "MultiThreadedDLL"
        }
      },
      "required": ["CMAKE_MSVC_RUNTIME_LIBRARY"],
      "type": "object"
    },
    "relative_path": {
      "maxLength": 2048,
      "minLength": 1,
      "pattern": "^(?!/|~|[A-Za-z]:)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*//)[^\\\\:]+$",
      "type": "string"
    }
  },
  "$id": "https://eutheto.dev/schemas/solver-build-evidence.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "allOf": [
    {
      "oneOf": [
        {
          "properties": {
            "architecture": {
              "const": "aarch64"
            },
            "target_triple": {
              "const": "aarch64-apple-darwin"
            }
          },
          "required": ["architecture", "target_triple"]
        },
        {
          "properties": {
            "architecture": {
              "const": "x86_64"
            },
            "target_triple": {
              "enum": [
                "x86_64-apple-darwin",
                "x86_64-pc-windows-msvc",
                "x86_64-unknown-linux-gnu"
              ]
            }
          },
          "required": ["architecture", "target_triple"]
        }
      ]
    },
    {
      "else": {
        "properties": {
          "cmake": {
            "properties": {
              "ortools": {
                "$ref": "#/$defs/non_windows_cmake_map"
              },
              "worker": {
                "$ref": "#/$defs/non_windows_cmake_map"
              }
            }
          }
        }
      },
      "if": {
        "properties": {
          "target_triple": {
            "const": "x86_64-pc-windows-msvc"
          }
        },
        "required": ["target_triple"]
      },
      "then": {
        "properties": {
          "cmake": {
            "properties": {
              "ortools": {
                "$ref": "#/$defs/windows_cmake_map"
              },
              "worker": {
                "$ref": "#/$defs/windows_cmake_map"
              }
            }
          }
        }
      }
    }
  ],
  "properties": {
    "architecture": {
      "enum": ["aarch64", "x86_64"]
    },
    "cmake": {
      "additionalProperties": false,
      "properties": {
        "ortools": {
          "$ref": "#/$defs/cmake_map"
        },
        "worker": {
          "$ref": "#/$defs/cmake_map"
        }
      },
      "required": ["ortools", "worker"],
      "type": "object"
    },
    "compiler": {
      "additionalProperties": false,
      "properties": {
        "identity": {
          "enum": ["clang", "gcc", "msvc"]
        },
        "version": {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9._+-]+$",
          "type": "string"
        }
      },
      "required": ["identity", "version"],
      "type": "object"
    },
    "linkage": {
      "const": "static-ortools"
    },
    "runtime_library_paths": {
      "items": {
        "$ref": "#/$defs/relative_path"
      },
      "maxItems": 128,
      "type": "array",
      "uniqueItems": true
    },
    "schema_version": {
      "const": 1
    },
    "target_triple": {
      "enum": [
        "aarch64-apple-darwin",
        "x86_64-apple-darwin",
        "x86_64-pc-windows-msvc",
        "x86_64-unknown-linux-gnu"
      ]
    },
    "worker": {
      "additionalProperties": false,
      "properties": {
        "adapter_version": {
          "const": "0.1.0"
        },
        "backend_id": {
          "const": "ortools-cp-sat"
        },
        "capabilities": {
          "const": [
            "cp-sat",
            "deterministic-time",
            "intermediate-solutions",
            "objective-bounds",
            "progress",
            "solution-projection",
            "solution-stats",
            "sufficient-assumptions"
          ],
          "maxItems": 64,
          "type": "array",
          "uniqueItems": true
        },
        "executable_path": {
          "$ref": "#/$defs/relative_path"
        }
      },
      "required": [
        "adapter_version",
        "backend_id",
        "capabilities",
        "executable_path"
      ],
      "type": "object"
    }
  },
  "required": [
    "architecture",
    "cmake",
    "compiler",
    "linkage",
    "runtime_library_paths",
    "schema_version",
    "target_triple",
    "worker"
  ],
  "title": "Eutheto OR-Tools solver build evidence v1",
  "type": "object"
}
