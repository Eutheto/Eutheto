{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "eutheto Phase 01 development shell",
  "version": "0.1.0",
  "identifier": "dev.eutheto.phase01.desktop",
  "build": {
    "beforeBuildCommand": "pnpm build",
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "security": {
      "capabilities": ["main"],
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' data:; script-src 'self'; style-src 'self' 'unsafe-inline'"
    },
    "windows": [
      {
        "label": "main",
        "title": "eutheto Phase 01 development shell",
        "width": 960,
        "height": 680,
        "minWidth": 320,
        "minHeight": 480,
        "resizable": true,
        "zoomHotkeysEnabled": true
      }
    ],
    "withGlobalTauri": false
  },
  "bundle": {
    "active": false
  }
}
