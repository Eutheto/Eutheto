{
  "name": "@eutheto/desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25",
    "pnpm": ">=11 <12"
  },
  "scripts": {
    "build": "vue-tsc --noEmit && vite build",
    "dev": "vite",
    "e2e": "node ./e2e/project-home.persistence.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings 0",
    "tauri": "tauri",
    "test": "vitest run",
    "test:browser": "vitest run --config vitest.browser.config.ts",
    "typecheck": "vue-tsc --noEmit"
  },
  "dependencies": {
    "@lucide/vue": "1.59.0",
    "@pinia/colada": "1.4.8",
    "@tanstack/vue-table": "9.3.1",
    "@tanstack/vue-virtual": "3.13.47",
    "@tauri-apps/api": "2.11.1",
    "@vue/devtools-api": "8.2.1",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "pinia": "4.1.0",
    "reka-ui": "2.11.0",
    "tailwind-merge": "3.7.0",
    "tw-animate-css": "1.4.0",
    "vue": "3.5.44",
    "vue-router": "5.3.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@tauri-apps/cli": "2.11.4",
    "@testing-library/vue": "8.1.0",
    "@types/node": "24.13.3",
    "@types/web-bluetooth": "0.0.21",
    "@vitejs/plugin-vue": "6.0.10",
    "@vitest/browser-playwright": "4.1.11",
    "@vue/compiler-dom": "3.5.44",
    "@vue/compiler-sfc": "3.5.44",
    "@vue/server-renderer": "3.5.44",
    "@vue/test-utils": "2.5.1",
    "axe-core": "4.14.0",
    "eslint": "10.13.0",
    "eslint-plugin-vue": "10.11.1",
    "playwright": "1.64.1",
    "prettier": "3.9.10",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vite": "8.3.4",
    "vitest": "4.1.11",
    "vue-component-type-helpers": "3.3.13",
    "vue-tsc": "3.3.13"
  }
}
