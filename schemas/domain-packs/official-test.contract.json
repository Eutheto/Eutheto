{
  "schemaVersion": 4,
  "pack": {
    "id": "official.test",
    "packVersion": "0.1.0",
    "latestSchemaVersion": 1,
    "portableSchemaVersion": 2,
    "shareResultSchemaVersion": 1
  },
  "setupQueries": [],
  "commands": [
    {
      "id": "official.test.configure_entity",
      "title": {
        "key": "official.test.command.configure_entity.title",
        "defaultText": "Configure test entity"
      },
      "description": {
        "key": "official.test.command.configure_entity.description",
        "defaultText": "Sets the bounded Boolean and integer values used by the contract fixture."
      },
      "risk": "ordinaryMutation",
      "reversibility": "inverseCommand",
      "aiGroupingAllowed": true,
      "payloadSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "additionalProperties": false,
        "required": ["entityId", "enabled", "target"],
        "properties": {
          "entityId": {
            "type": "string",
            "format": "uuid"
          },
          "enabled": {
            "type": "boolean"
          },
          "target": {
            "type": "integer",
            "minimum": 0,
            "maximum": 10
          }
        }
      },
      "resultSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "additionalProperties": false,
        "required": ["entityId"],
        "properties": {
          "entityId": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "changeSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "before", "after"],
        "properties": {
          "path": {
            "type": "string",
            "pattern": "^/domain/entities/"
          },
          "before": {},
          "after": {}
        }
      },
      "validExamples": [
        {
          "entityId": "018f25a7-8b3c-7d11-8000-000000000001",
          "enabled": true,
          "target": 3
        }
      ],
      "invalidExamples": [
        {
          "entityId": "not-a-uuid",
          "enabled": true,
          "target": 11
        }
      ]
    }
  ],
  "internalSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "additionalProperties": false,
    "required": ["entities", "rules", "preferences", "lockedAssignments"],
    "properties": {
      "entities": {
        "type": "object",
        "additionalProperties": { "type": "object" }
      },
      "rules": {
        "type": "object",
        "additionalProperties": { "type": "object" }
      },
      "preferences": {
        "type": "object",
        "additionalProperties": { "type": "object" }
      },
      "lockedAssignments": {
        "type": "object",
        "additionalProperties": { "type": "object" }
      }
    }
  },
  "portableSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "additionalProperties": false,
    "required": ["schemaVersion", "entities", "rules", "preferences", "lockedAssignments", "extensions"],
    "properties": {
      "schemaVersion": {
        "const": 2
      },
      "entities": {
        "type": "object",
        "additionalProperties": {
          "type": "object"
        }
      },
      "rules": {
        "type": "object",
        "additionalProperties": {
          "type": "object"
        }
      },
      "preferences": {
        "type": "object",
        "additionalProperties": {
          "type": "object"
        }
      },
      "lockedAssignments": {
        "type": "object",
        "additionalProperties": {
          "type": "object"
        }
      },
      "extensions": {
        "type": "object"
      }
    }
  },
  "shareResultSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "additionalProperties": false,
    "required": ["schemaVersion", "assignments"],
    "properties": {
      "schemaVersion": {
        "const": 1
      },
      "assignments": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": ["assignmentId", "value"],
          "properties": {
            "assignmentId": {
              "type": "string"
            },
            "value": {
              "oneOf": [
                { "type": "boolean" },
                { "type": "integer" },
                { "type": "null" }
              ]
            }
          }
        }
      }
    }
  },
  "aiTools": [
    {
      "commandId": "official.test.configure_entity",
      "name": "configure_test_entity",
      "description": "Configure one synthetic contract entity with bounded values."
    }
  ],
  "uiManifest": {
    "setupSteps": [
      {
        "id": "official.test.setup.entity",
        "title": {
          "key": "official.test.setup.entity.title",
          "defaultText": "Synthetic test contract"
        },
        "description": {
          "key": "official.test.ui.description",
          "defaultText": "Configure a synthetic entity."
        }
      }
    ],
    "entityKinds": [
      {
        "id": "official.test.entity",
        "title": {
          "key": "official.test.entity.title",
          "defaultText": "Synthetic test contract"
        },
        "description": {
          "key": "official.test.ui.description",
          "defaultText": "Synthetic Boolean/integer entity."
        }
      }
    ],
    "ruleKinds": [
      {
        "id": "official.test.required-target",
        "title": {
          "key": "official.test.rule.required_target.title",
          "defaultText": "Synthetic test contract"
        },
        "description": {
          "key": "official.test.ui.description",
          "defaultText": "Enabled iff target is positive."
        }
      }
    ],
    "goalKinds": [
      {
        "id": "official.test.goal.target",
        "title": {
          "key": "official.test.goal.target.title",
          "defaultText": "Minimize target"
        },
        "description": {
          "key": "official.test.goal.target.title.description",
          "defaultText": "Minimize the bounded target total."
        }
      }
    ],
    "scoreKinds": [
      {
        "id": "official.test.score.target-total",
        "title": {
          "key": "official.test.score.target_total.title",
          "defaultText": "Target total"
        },
        "minimize": true
      }
    ],
    "provenanceKinds": [
      {
        "id": "official.test.provenance.required-target",
        "title": {
          "key": "official.test.provenance.required_target.title",
          "defaultText": "Required target"
        },
        "description": {
          "key": "official.test.provenance.required_target.title.description",
          "defaultText": "Traces the synthetic enabled/target relation."
        }
      }
    ],
    "resultViews": [
      {
        "id": "official.test.result.summary",
        "title": {
          "key": "official.test.result.summary.title",
          "defaultText": "Synthetic test contract"
        },
        "description": {
          "key": "official.test.ui.description",
          "defaultText": "Synthetic result summary."
        }
      }
    ],
    "importers": [
      {
        "id": "official.test.import.portable-v2",
        "title": {
          "key": "official.test.import.title",
          "defaultText": "Import portable test data"
        },
        "schemaVersion": 1
      }
    ],
    "exporters": [
      {
        "id": "official.test.export.portable-v2",
        "title": {
          "key": "official.test.export.title",
          "defaultText": "Export portable test data"
        },
        "schemaVersion": 1
      }
    ]
  }
}
