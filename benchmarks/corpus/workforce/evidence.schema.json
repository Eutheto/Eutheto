              "appendix-f",
              "clinic-tiny",
              "clinic-initial",
              "clinic-full",
              "clinic-overnight",
              "rolling-hours",
              "specialist-coverage",
              "repair-before",
              "infeasible-coverage",
              "dst-spring",
              "dst-fall",
              "large-supported",
              "large-pressure"
            ],
            "type": "string"
          },
          "maximumMilliseconds": {
            "maximum": 18446744073709551615,
            "minimum": 0,
            "type": "integer"
          },
          "medianMilliseconds": {
            "maximum": 18446744073709551615,
            "minimum": 0,
            "type": "integer"
