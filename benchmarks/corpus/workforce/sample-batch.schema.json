                  "translatedVariables": {
                    "maximum": 18446744073709551615,
                    "minimum": 0,
                    "type": "integer"
                  },
                  "versions": {
                    "additionalProperties": {
                      "maxLength": 256,
                      "minLength": 1,
                      "type": "string"
                    },
                    "maxProperties": 32,
                    "propertyNames": {
                      "maxLength": 128,
                      "minLength": 1,
                      "pattern": "^[A-Za-z][A-Za-z0-9._-]*$",
                      "type": "string"
