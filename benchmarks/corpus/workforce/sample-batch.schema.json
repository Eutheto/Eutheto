        "additionalProperties": false,
        "properties": {
          "acceptance": {
            "anyOf": [
              {
                "additionalProperties": false,
                "properties": {
                  "consumerChecks": {
                    "items": {
                      "maxLength": 256,
                      "minLength": 1,
                      "type": "string"
                    },
                    "maxItems": 64,
                    "minItems": 1,
                    "type": "array"
                  },
                  "feasibility": {
                    "maximum": 9223372036854775807,
                    "minimum": -9223372036854775808,
                    "type": "integer"
                  },
                  "portableSha256": {
                    "maxLength": 64,
                    "minLength": 64,
