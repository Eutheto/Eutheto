{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Private synthetic corpus record. Structural validation does not prove source fidelity, safe filesystem custody, cross-file digest binding, accepted-result authority, historical execution authenticity or timing relationships; the corpus runner performs those applicable checks.",
  "properties": {
    "availabilityId": {
      "format": "uuid",
      "maxLength": 36,
      "minLength": 36,
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "type": "string"
    },
    "baselineRequirement": {
      "const": "Phase07: obtain a genuine independently accepted solution of practitioner-workflow and select it as the baseline; bind this call-out to the canonical first accepted pair on the exact 2027-02-10 weekday clinic that is not Hard-locked"
    },
    "beforeCase": {
      "const": "practitioner-workflow"
    },
    "commandId": {
      "const": "official.workforce.add_entity"
    },
    "corpusVersion": {
      "const": 2
    },
    "effectiveRange": {
      "additionalProperties": false,
      "properties": {
        "endDateExclusive": {
          "const": "2027-03-01"
        },
        "startDate": {
          "const": "2027-02-01"
        }
      },
      "required": [
        "startDate",
        "endDateExclusive"
      ],
      "type": "object"
    },
    "executionPhase": {
      "const": 7
    },
    "format": {
      "const": "eutheto/workforce-repair-fixture"
    },
    "repairRequirement": {
      "const": "Phase07: repair from that accepted and selected baseline after this single unavailable-person mutation; pure mutation validation is not repair execution"
    },
    "schemaVersion": {
      "const": 2
    },
    "targetShiftId": {
      "format": "uuid",
      "maxLength": 36,
      "minLength": 36,
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "type": "string"
    },
    "timeWindow": {
      "additionalProperties": false,
      "properties": {
        "endsAt": {
          "const": "2027-02-11T01:00:00Z"
        },
        "kind": {
          "const": "instant"
        },
        "startsAt": {
          "const": "2027-02-10T13:00:00Z"
        }
      },
      "required": [
        "kind",
        "startsAt",
        "endsAt"
      ],
      "type": "object"
    }
  },
  "required": [
    "format",
    "schemaVersion",
    "corpusVersion",
    "availabilityId",
    "targetShiftId",
    "timeWindow",
    "effectiveRange",
    "beforeCase",
    "executionPhase",
    "baselineRequirement",
    "commandId",
    "repairRequirement"
  ],
  "title": "Workforce corpus v2 repair",
  "type": "object"
}
